{
  "enabledPlugins": {
    "vercel@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/roadmap.mjs next*)", "Bash(node .claude/scripts/roadmap.mjs show *)",
      "Bash(node .claude/scripts/roadmap.mjs mark *)", "Bash(node .claude/scripts/spec.mjs *)",
      "Bash(node .claude/hooks/*)",
      "Bash(git status)", "Bash(git status *)", "Bash(git diff)", "Bash(git diff *)",
      "Bash(git log *)", "Bash(git show *)", "Bash(git add *)", "Bash(git commit *)", "Bash(git mv *)",
      "Bash(git stash list)", "Bash(git stash show *)",
      "Bash(curl -fsS http://localhost*)",
      {{ALLOW_CMDS_ITEMS}}
    ],
    "ask": [
      "Bash(git push *)", "Bash(git reset *)", "Bash(git checkout *)", "Bash(git restore *)",
      "Bash(git clean *)", "Bash(git rebase *)", "Bash(git remote *)",
      "Bash(docker *)", "Bash(ssh *)", "Bash(scp *)", "Bash(rsync *)", "Bash(gh *)",
      "Bash(node .claude/scripts/roadmap.mjs ungate *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)",
      "Bash(cat .env*)", "Bash(cat ./.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|NotebookEdit", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"" }{{FORMAT_HOOKS_EXTRA}} ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-typecheck.mjs\"", "timeout": 120 }{{STOP_HOOKS_EXTRA}} ] }
    ]
  }
}
