#!/usr/bin/env bash
# reading-autopilot: split a book, write its reading companions and build its companion EPUB,
# unattended, with a live progress bar.
#
#   reading-autopilot <book.pdf | book folder>   run; outside tmux it opens tmux session autopilot-<book>
#   reading-autopilot attach                     reattach to a running autopilot's tmux session
#
# Stages, each one headless `claude -p` session running a skill:
#   split       /split-book        done: chapters/.split-done
#   companions  /reading-companion done: companions/.done
#   epub        /companion-epub    done: companions/.epub-done
# A stage the autopilot never ran (no scratch folder of its own) also counts as done when its output
# exists: a manifest whose chapter PDFs all exist; a companion PDF for every part plus the overview;
# an EPUB newer than every companion source. So books made by hand are picked up where they are.
# Done stages are skipped, so running it again resumes. Logs: <book>/autopilot-logs/ (autopilot.log
# timeline; <stage>.<time>.jsonl sessions; .report.md, each session's final report).
#
# - Sessions load no user settings (--setting-sources project,local): no RTK hook, no caveman or
#   ponytail plugins. Model and effort come from SESSION_SETTINGS. Tools: the skill's allowed-tools;
#   anything else goes to the auto-mode classifier.
# - Memory: the whole run sits in a systemd scope with MemoryMax=4G, so a runaway is killed, not the desktop.
# - Keeps the machine awake (systemd-inhibit). notify-send when it finishes or stops.
# - Usage limits: waits for the 5-hour reset; pauses while 7-day usage is over WEEKLY_CAP.
# - A session that ends with its stage unfinished is retried, MAX_TRIES in all.
# - Any permission denial stops the run: the skill needs another allowed tool. A stop writes
#   autopilot-logs/STOPPED with the reason; delete it to run again.
set -uo pipefail

WEEKLY_CAP=0.90
FIVE_HOUR_FULL=0.97
SESSION_TIMEOUT=8h
MAX_TRIES=3
MEMORY_MAX=4G
SESSION_SETTINGS='{"model":"opus","alwaysThinkingEnabled":true,"modelSettings":{"claude-opus-5-5":{"effortLevel":"high"}}}'
SKILLS=$HOME/.claude/skills
CLAUDE=${CLAUDE_BIN:-claude} # a fake claude for testing
declare -A SKILL_OF=([split]=split-book [companions]=reading-companion [epub]=companion-epub)

die() { echo "reading-autopilot: $*" >&2; exit 1; }

if [[ ${1:-} == attach ]]; then
  s=$(tmux list-sessions -F '#S' 2>/dev/null | grep '^autopilot-' | head -1)
  [[ -n $s ]] || die "no autopilot tmux session is running"
  exec tmux attach -t "=$s"
fi
[[ $# == 1 ]] || { sed -n '2,6p' "$0"; exit 2; }

# --- the book ---
if [[ -d $1 ]]; then
  BOOKDIR=$(realpath -s "$1")
  pdfs=()
  for f in "$BOOKDIR"/*.pdf; do [[ -f $f ]] && pdfs+=("$f"); done
  ((${#pdfs[@]} == 1)) || die "expected exactly one PDF in $BOOKDIR, found ${#pdfs[@]}"
  PDF=${pdfs[0]}
else
  [[ -f $1 && $1 == *.pdf ]] || die "not a PDF or folder: $1"
  PDF=$(realpath -s "$1")
  BOOKDIR=$(dirname "$PDF")
fi
NAME=$(basename "$BOOKDIR")
C=$BOOKDIR/companions
LOGS=$BOOKDIR/autopilot-logs
MANIFEST=$BOOKDIR/chapters/.parts.json
EPUB=$BOOKDIR/$NAME-companion.epub

# --- wrappers: tmux, then memory scope and sleep inhibitor ---
if [[ -z ${TMUX:-} ]]; then
  session=autopilot-${NAME//[.:]/-}
  tmux has-session -t "=$session" 2>/dev/null && exec tmux attach -t "=$session"
  exec tmux new-session -s "$session" \
    "$(printf '%q ' "$0" "$PDF"); echo; read -rp 'Press Enter to close this window.'"
fi
if [[ -z ${AUTOPILOT_WRAPPED:-} ]]; then
  export AUTOPILOT_WRAPPED=1
  exec systemd-run --user --scope --quiet -p MemoryMax=$MEMORY_MAX \
    systemd-inhibit --what=idle:sleep:handle-lid-switch --who=reading-autopilot --why="$NAME" "$0" "$PDF"
fi

mkdir -p "$LOGS"
exec 9>"$LOGS/.lock"
flock -n 9 || die "an autopilot is already running for $NAME"
STOPPED=$LOGS/STOPPED
[[ -f $STOPPED ]] && die "stopped earlier: $(cat "$STOPPED"). Delete $STOPPED to run again."
for cmd in "$CLAUDE" jq uv pdftotext java chromium notify-send; do
  command -v "$cmd" >/dev/null || die "missing command: $cmd"
done
for s in "${SKILL_OF[@]}"; do [[ -f $SKILLS/$s/SKILL.md ]] || die "missing skill: $SKILLS/$s/SKILL.md"; done
# Fetch the Python packages now, not during a network blip at 3 am.
uv run --quiet --with markdown --with pymupdf --with pikepdf python -I -c 'import markdown, pymupdf, pikepdf' ||
  die "uv could not fetch markdown, pymupdf, pikepdf"

# --- stage state ---
nparts() { jq '.parts | length' "$MANIFEST" 2>/dev/null || echo 0; }
split_done() {
  [[ -f $BOOKDIR/chapters/.split-done ]] && return 0
  [[ -f $MANIFEST && ! -d $BOOKDIR/chapters/.scratch ]] || return 1
  local f
  while read -r f; do [[ -f $BOOKDIR/chapters/$f ]] || return 1; done < <(jq -r '.parts[].file' "$MANIFEST")
}
companions_done() {
  [[ -f $C/.done ]] && return 0
  [[ -f $MANIFEST && -f $C/book-overview-companion.pdf && ! -f $C/.checked ]] || return 1
  local f
  while read -r f; do compgen -G "$C/${f:0:2}-*-companion.pdf" >/dev/null || return 1; done < <(jq -r '.parts[].file' "$MANIFEST")
}
companions_count() { # units checked so far, overview included
  if companions_done; then echo $(($(nparts) + 1)); else sort -u "$C/.checked" 2>/dev/null | grep -c .; fi
}
epub_done() {
  [[ -f $C/.epub-done ]] && return 0
  [[ -f $EPUB && -d $C/src && ! -d $C/.scratch/epub ]] || return 1
  [[ -z $(find "$C/src" -name '*.md' -newer "$EPUB" -print -quit) ]]
}
stage_done() { "${1}_done"; }

# --- progress display ---
RUN_START=$(date +%s) STAGE='' TRY=0 SESSION_START=0 CUR_LOG='' WAITING='' H5='' D7='' BAR_LINES=0
dur() { local s=$1; ((s >= 3600)) && printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60)) || printf '%dm' $((s / 60)); }
pct() { awk -v u="$1" 'BEGIN { printf "%d%%", u * 100 + 0.5 }'; }
usage_now() { # latest 5h and 7d utilization from the running session's log
  [[ -f $CUR_LOG ]] || return
  local row
  row=$(tail -n 400 "$CUR_LOG" | jq -rR 'fromjson? | select(.type == "rate_limit_event") | .rate_limit_info.unifiedWindows
    | [.five_hour.utilization // "", .seven_day.utilization // ""] | @tsv' 2>/dev/null | tail -1)
  [[ -n $row ]] && IFS=$'\t' read -r H5 D7 <<<"$row"
}
render() {
  local n chk total done_split=0 frac_c=0 frac_e=0 p filled bar mark detail now
  now=$(date +%s)
  n=$(nparts)
  split_done && done_split=1
  chk=$(companions_count) total=$((n + 1))
  ((n > 0)) && frac_c=$((100 * chk / total))
  if epub_done; then frac_e=100; elif [[ $STAGE == epub && -f $EPUB && $(stat -c %Y "$EPUB") -ge $SESSION_START ]]; then frac_e=50; fi
  p=$((5 * done_split + 80 * frac_c / 100 + 15 * frac_e / 100))
  filled=$((p * 30 / 100))
  bar=$(printf '%*s' "$filled" '' | sed 's/ /█/g')$(printf '%*s' $((30 - filled)) '' | sed 's/ /░/g')
  printf '%s  [%s] %3d%%\n' "$NAME" "$bar" "$p"
  for s in split companions epub; do
    if stage_done "$s"; then mark='✓'; elif [[ $s == "$STAGE" ]]; then mark='▶'; else mark='·'; fi
    case $s in
    split) detail=$( ((done_split)) && echo "$n units" || { [[ $STAGE == split ]] && echo "finding chapter boundaries"; }) ;;
    companions) detail=$( ((n > 0)) && echo "$chk/$total units checked") ;;
    epub)
      if ((frac_e == 100)); then detail=${EPUB##*/}
      elif ((frac_e == 50)); then detail="built, checking and fixing"
      elif [[ $STAGE == epub ]]; then detail="probing the layout"
      else detail=''; fi ;;
    esac
    [[ $s == "$STAGE" && $SESSION_START -gt 0 && -z $WAITING ]] &&
      detail+="   (session $(dur $((now - SESSION_START))), try $TRY/$MAX_TRIES)"
    printf '  %s %-11s %s\n' "$mark" "$s" "$detail"
  done
  local tail="elapsed $(dur $((now - RUN_START)))"
  [[ -n $H5 ]] && tail+=" · 5h usage $(pct "$H5")"
  [[ -n $D7 ]] && tail+=" · 7d usage $(pct "$D7")"
  [[ -n $WAITING ]] && tail+=$'\n  ⏸ '"$WAITING"
  printf '  %s\n' "$tail"
}
clear_bar() { ((BAR_LINES > 0)) && printf '\e[%dA\e[J' "$BAR_LINES"; BAR_LINES=0; }
draw() {
  local out
  out=$(render)
  clear_bar
  printf '%s\n' "$out"
  BAR_LINES=$(($(printf '%s\n' "$out" | wc -l)))
}
log() {
  local line
  line="$(date '+%a %H:%M')  $*"
  echo "$line" >>"$LOGS/autopilot.log"
  clear_bar
  echo "$line"
  draw
}
notify() { notify-send "Reading autopilot: $NAME" "$1" 2>/dev/null || true; }
stop_for() { echo "$1" >"$STOPPED"; log "STOPPED: $1"; notify "Stopped: $1"; exit 1; }
wait_until() { # $1 epoch, $2 reason
  WAITING="$2 until $(date -d "@$1" '+%a %d %b %H:%M')"
  log "$WAITING"
  while (($(date +%s) < $1)); do draw; sleep 5; done
  WAITING=''
}
events() { jq -rR "fromjson? | $1" "$2" 2>/dev/null; } # stream-json log; stderr lines are skipped
ge() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a != "" && a + 0 >= b + 0) }'; }

# --- prompts ---
overrides() {
  case $1 in
  split) cat <<EOF
- <scratchpad> = $BOOKDIR/chapters/.scratch
- Last step, only once the chapter PDFs and chapters/.parts.json are written: write your final
  report to $BOOKDIR/chapters/.split-done. Never write that file otherwise.
EOF
    ;;
  companions) cat <<EOF
- SCRATCH = $C/.scratch
- Resume (replaces step 4's rule): a unit is finished only when its chapter file name (e.g.
  03-third-part.pdf) is a line in $C/.checked. Append that line yourself when the unit's checker
  has returned. A unit with a .md but no line there was cut off: give it a fresh writer, which
  overwrites the .md, then a checker. List the units you skipped in the report.
- When the book overview's .md is written and checked, append the line book-overview to $C/.checked.
- Run at most 8 writer subagents at a time. Launch the next one as one returns.
- Last step, only once every step-6 gate passes for every unit and the overview: write the step-7
  report to $C/.done. Never write that file otherwise.
EOF
    ;;
  epub) cat <<EOF
- SCRATCH = $C/.scratch/epub
- Last step, once step 5's conditions hold or its fifth round is done: write the step-6 report
  to $C/.epub-done. Never write that file otherwise.
EOF
    ;;
  esac
}
prompt_for() {
  local skill=$SKILLS/${SKILL_OF[$1]}/SKILL.md body
  body=$(awk 'n >= 2; /^---$/ { n++ }' "$skill") # the body, without frontmatter
  cat <<EOF
You are running unattended: nobody will answer questions or approve prompts. Follow the skill
instructions below in full, with \$ARGUMENTS = $PDF, except where these overrides say otherwise.

Overrides:
$(overrides "$1")

EOF
  printf '%s\n' "${body//'$ARGUMENTS'/"$PDF"}"
}
tools_for() { sed -n 's/^allowed-tools: //p' "$SKILLS/${SKILL_OF[$1]}/SKILL.md" | sed 's/, /\n/g'; }

# --- one session ---
run_session() { # $1 = stage; sets rc, CUR_LOG
  local tools pid
  mapfile -t tools < <(tools_for "$1")
  CUR_LOG=$LOGS/$1.$(date +%m%d-%H%M%S).jsonl
  SESSION_START=$(date +%s)
  log "$1: session start (try $TRY/$MAX_TRIES, log ${CUR_LOG##*/})"
  timeout --kill-after=60 "$SESSION_TIMEOUT" "$CLAUDE" -p "$(prompt_for "$1")" \
    --setting-sources project,local --settings "$SESSION_SETTINGS" \
    --permission-mode auto --allowedTools "${tools[@]}" \
    --output-format stream-json --verbose >"$CUR_LOG" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    usage_now
    draw
    sleep 3
  done
  wait "$pid"
  rc=$?
  SESSION_START=0
  events 'select(.type == "result") | .result // empty' "$CUR_LOG" >"${CUR_LOG%.jsonl}.report.md"
}

# --- main ---
draw
log "start: $PDF"
for stage in split companions epub; do
  stage_done "$stage" && continue
  STAGE=$stage TRY=0 limit_waits=0 WEEKLY_RESET=0
  until stage_done "$stage"; do
    if ge "$D7" "$WEEKLY_CAP"; then
      now=$(date +%s)
      wait_until $((WEEKLY_RESET > now ? WEEKLY_RESET + 120 : now + 3600)) "7-day usage at $(pct "$D7"): paused"
      D7=''
      continue
    fi
    TRY=$((TRY + 1))
    run_session "$stage"

    IFS=$'\t' read -r status resets h5 h5_resets d7 d7_resets < <(events 'select(.type == "rate_limit_event")
      | .rate_limit_info | [.status // "", .resetsAt // 0, .unifiedWindows.five_hour.utilization // "",
        .unifiedWindows.five_hour.resetsAt // 0, .unifiedWindows.seven_day.utilization // "",
        .unifiedWindows.seven_day.resetsAt // 0] | @tsv' "$CUR_LOG" | tail -1)
    [[ -n ${h5:-} ]] && H5=$h5
    [[ -n ${d7:-} ]] && D7=$d7 WEEKLY_RESET=${d7_resets:-0}
    IFS=$'\t' read -r mins denials denied < <(events 'select(.type == "result")
      | [((.duration_ms // 0) / 60000 | floor), (.permission_denials // [] | length),
         (.permission_denials // [] | map(.tool_name) | unique | join(","))] | @tsv' "$CUR_LOG" | tail -1)
    log "$stage: session ended rc $rc, ${mins:-?} min, permission denials ${denials:-?}${denied:+ ($denied)}"
    ((${denials:-0} > 0)) && stop_for "$stage: ${denials} permission denial(s) (${denied}); see ${CUR_LOG##*/}"
    stage_done "$stage" && break

    reset=''
    if [[ -n ${status:-} && $status != allowed ]]; then
      reset=$resets
    elif ge "${h5:-}" "$FIVE_HOUR_FULL"; then
      reset=$h5_resets
    elif grep -qiE 'usage limit|limit reached|hit your limit|rate_limit_error|API Error: 429' "$CUR_LOG"; then
      reset=0
    fi
    if [[ -n $reset ]]; then
      now=$(date +%s)
      [[ $reset =~ ^[0-9]+$ ]] || reset=0
      ((reset > 100000000000)) && reset=$((reset / 1000)) # milliseconds
      limit_waits=$((limit_waits + 1))
      TRY=$((TRY - 1)) # a usage limit is not a failed try
      wait_until $((reset > now ? reset + 120 : now + (limit_waits >= 3 ? 3600 : limit_waits * 900))) "usage limit: waiting"
      continue
    fi
    ((TRY >= MAX_TRIES)) && stop_for "$stage still unfinished after $MAX_TRIES tries; see $LOGS"
    wait_until $(($(date +%s) + 600)) "$stage unfinished: retrying" # an API outage usually passes in minutes
  done
  log "$stage: done"
done
STAGE=''
summary="all stages done in $(dur $(($(date +%s) - RUN_START))): $EPUB"
log "$summary"
for s in split companions epub; do
  r=$(compgen -G "$LOGS/$s.*.report.md" | sort | tail -1)
  [[ -n $r ]] && echo "  $s report: $r"
done
notify "$summary"
